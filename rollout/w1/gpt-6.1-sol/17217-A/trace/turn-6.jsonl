{"direction":"recv","message":{"method":"item/tool/call","id":35,"params":{"threadId":"native-1","turnId":"native-61","callId":"native-68","namespace":null,"tool":"office_shell","arguments":{"command":"mkdir -p notes/七月会签; cp input/财务会签/额度签署登记.csv inbox/FN-F72.eml inbox/TR-0731.eml input/资金运营/垫付直联流水.csv notes/七月会签/; python3 - <<'PY'\nimport csv,collections\nfrom decimal import Decimal as D\nfrom pathlib import Path\ndef read(p):return list(csv.DictReader(open(p)))\nlatest={}\nfor r in read('input/财务会签/额度签署登记.csv'):\n if r['decision'] in ['签发','撤销'] and r['signed']<='2025-07-31 18:00':\n  k=r['document']\n  if k not in latest or int(r['revision'])>int(latest[k]['revision']):latest[k]=r\npool=collections.defaultdict(lambda:D(0))\nfor r in latest.values():\n if r['decision']=='签发':pool[r['project']]+=D(r['amount'])\nwith open('out/released.csv','w',newline='') as f:\n w=csv.writer(f);w.writerow(['project','pool']);w.writerows([[p,format(pool[p],'.2f')] for p in ['甲','乙']])\nPath('notes/七月会签/额度核定说明.txt').write_text('F-72仅放行甲乙，丙待签。额度截点2025-07-31 18:00含该时刻，逐document最高正式签发/撤销整版。F-401/402取第1版；P-31/32取第2版负调增；W-31/32第2版撤销不计。甲10084.47-90=9994.47，乙10236.72-81=10155.72。晚签、草拟不覆盖。\\n')\n# 范围变更单独留底，不覆盖历史常设和临时批准\nPath('notes/代8337-江东撤回.txt').write_text('用户签发：自2025-08-01起，仅江东库撤回代8337。江东乙项目待清恢复岗8013、限额380元、常2622；南港仍按代8337至2025-08-04含当日。其他事项不变。\\n')\nwith open('notes/停8228.csv','w',newline='') as f:\n w=csv.writer(f);w.writerow('authority,office,vendor,desk,valid_from,valid_to,decision'.split(','))\n for o in ['江东','南港']:w.writerow(['停8228',o,'栩新','IC-01','2025-08-04','2025-08-04','HOLD'])\nlatest={}\nfor r in read('input/资金运营/垫付直联流水.csv'):\n if r['approval']=='确认' and r['stamp']<='2025-07-31 17:00':\n  k=r['bank'],r['ref']\n  if k not in latest or int(r['revision'])>int(latest[k]['revision']):latest[k]=r\nbanks={r['bank'] for r in read('input/核验往来/资金抽核委托.csv') if r['approval']=='签发'}\nfor bank in sorted(banks):\n out=[]\n for (b,ref),r in latest.items():\n  if b!=bank:continue\n  if r['kind']=='付款' and r['state']=='在途' and r['period']=='2025-07':out.append([b,ref,'',r['amount']])\n  if r['kind']=='退回' and r['state']=='到账':\n   old=latest.get((b,r['original']))\n   if old and old['kind']=='付款' and old['state']=='到账' and old['period']=='2025-07':out.append([b,ref,r['original'],r['amount']])\n with open('out/verify/银核-'+bank+'.csv','w',newline='') as f:\n  w=csv.writer(f);w.writerow(['bank','ref','original','amount']);w.writerows(sorted(out))\n print(bank,len(out))\nprint(open('out/released.csv').read())\nPY"}}}}
